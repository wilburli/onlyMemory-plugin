{
  "name": "only-memory",
  "version": "0.1.0",
  "description": "DeepSeek Harness 记忆插件 - 零外部依赖的 LLM 长期记忆系统",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "only-memory-server": "./bin/only-memory.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "cordis.patch.yml",
    "node_modules/sql.js/dist/sql-wasm.wasm"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --import tsx tests/test.ts",
    "clean": "rimraf dist",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "memory",
    "plugin",
    "cordis"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "latest",
    "@deepseek-ai/schemastery": "latest",
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
